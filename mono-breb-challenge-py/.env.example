# URL base del ambiente Sandbox de Bre-B Participant
MONO_BASE_URL=https://breb-participant.sandbox.mono.la

# Credenciales OAuth 2.0 (Client Credentials) entregadas por Mono
MONO_CLIENT_ID=tu_client_id
MONO_CLIENT_SECRET=tu_client_secret

# Scopes requeridos por la app (lectura y escritura de collections y outgoing_transfers)
MONO_SCOPES=collections outgoing_transfers target_resolutions tenant_accounts:readonly

# Cuenta tenant contra la que se crean recaudos y transferencias (te la entrega Mono)
MONO_TENANT_ACCOUNT_ID=bbtacc_xxxxxxxxxxxxxxxxxxxxxx

# Puerto local del servidor
PORT=3000

# Secreto opcional para validar la firma de los webhooks entrantes (si Mono lo provee)
MONO_WEBHOOK_SECRET=
